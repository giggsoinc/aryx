# Aryx — 12-factor configuration. Copy to .env and adjust. NEVER commit .env.
# All app settings are read from ARYX_-prefixed environment variables.

# Canonical relational store (P1: RDB is the source of truth).
ARYX_RDB_DSN=postgresql://aryx:aryx@postgres:5432/aryx

# Derived, rebuildable graph projection.
ARYX_GRAPH_URL=redis://falkordb:6379

ARYX_LOG_LEVEL=INFO
ARYX_BATCH_SIZE=500

# LLM runtime (Ask + ingest). Also editable live at /settings in the web UI.
# Keys in Settings stay in process memory; env sets boot defaults.
ARYX_LLM_PROVIDER=ollama
ARYX_LLM_BASE_URL=http://ollama:11434
ARYX_LLM_MENIAL_MODEL=qwen3.5:0.8b
ARYX_LLM_REASON_MODEL=lfm2.5-thinking:latest
ARYX_LLM_API_KEY=
# Examples:
#   ARYX_LLM_PROVIDER=google
#   ARYX_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   ARYX_LLM_PROVIDER=xai
#   ARYX_LLM_BASE_URL=https://api.x.ai/v1

# Used only by docker-compose to seed the local postgres container.
POSTGRES_PASSWORD=aryx

# Set to 5 here so ambiguous pairs actually get an LLM rescore instead of
# skipping straight to the human queue (0 = LLM adjudication off)
ARYX_ER_MAX_ADJUDICATIONS=5

# --- PDF / document ingest (all optional; the defaults work) ---------------------
# Embeddings follow the LLM provider: with Gemini/OpenAI they use that provider's
# embedding model, so no Ollama container is needed. Override only to point at a
# separate embedding service:
#   ARYX_EMBED_ENDPOINT=http://ollama:11434
#   ARYX_EMBED_MODEL=nomic-embed-text
# ARYX_EMBED_MODEL names the OLLAMA model and is never sent to a cloud provider by
# default (a Gemini setup that keeps it still works). To name a cloud embedding
# model, also set ARYX_EMBED_PROVIDER=cloud (below); an Ollama model name such as
# nomic-embed-text is then ignored with a warning.
# Parallel text reading: chunks asked of the model at once, and tries per chunk.
#   ARYX_EXTRACT_WORKERS=3
#   ARYX_EXTRACT_ATTEMPTS=2
# Per-document time limit (seconds): at least ARYX_PER_DOC_TIMEOUT, and
# ARYX_PER_PAGE_TIMEOUT x pages for a long PDF.
#   ARYX_PER_DOC_TIMEOUT=300
#   ARYX_PER_PAGE_TIMEOUT=30
# Relationship step: parallel model calls and a time budget in seconds.
#   ARYX_RELATE_WORKERS=6
#   ARYX_RELATE_BUDGET_S=300
# Scanned PDFs: a vision model reads pages that have no text (Gemini / OpenAI
# provider only). OFF by default: the page IMAGES are sent to the LLM provider
# (they leave this deployment and cannot be PII-screened like text). Turn on with
# ARYX_OCR=auto; the page cap limits cost per document.
#   ARYX_OCR=off
#   ARYX_OCR_MAX_PAGES=30
# Chunk embeddings on a cloud LLM provider: "auto" (default) uses the provider's
# embedding model only when no Ollama answers; "cloud" forces it; "ollama" refuses
# it. An explicit ARYX_EMBED_ENDPOINT always means Ollama.
#   ARYX_EMBED_PROVIDER=auto
# Tables-only: read the tables of a PDF/DOCX as rows and pull no entities from
# the paragraphs (exact and repeatable). Per upload: form field tables_only=true.
#   ARYX_TABLES_ONLY=false
